<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400;1,700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --verde:       #1b4332;
  --verde-med:   #2d6a4f;
  --verde-light: #52b788;
  --verde-pale:  #d8f3dc;
  --oro:         #b5843a;
  --crema:       #faf7f2;
  --gris-100:    #f4f1ec;
  --gris-200:    #eae6de;
  --gris-300:    #d6d0c4;
  --gris-500:    #8c8579;
  --gris-700:    #3d3830;
  --negro:       #1a1714;
}
html { scroll-behavior: smooth; }
body { font-family: 'Inter', sans-serif; background: var(--crema); color: var(--negro); overflow-x: hidden; }

/* ─── HERO ─── */
.hero {
  min-height: 100vh; background: var(--verde);
  display: grid; grid-template-rows: auto 1fr auto;
  position: relative; overflow: hidden;
}
.hero-ring {
  position: absolute; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.06); pointer-events: none;
}
.hero-ring:nth-child(1) { width:700px;height:700px;top:-250px;right:-250px; }
.hero-ring:nth-child(2) { width:1000px;height:1000px;top:-450px;right:-450px; }
.hero-ring:nth-child(3) { width:340px;height:340px;bottom:40px;left:-140px;background:rgba(82,183,136,0.05);border:none; }
.hero-top {
  display:flex;justify-content:space-between;align-items:center;
  padding:36px 60px; position:relative;z-index:2;
}
.brand { display:flex;align-items:center;gap:14px; }
.brand-mark {
  width:46px;height:46px;background:var(--verde-light);border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:700;color:white;
}
.brand-name { font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:600;color:white;letter-spacing:1px; }
.brand-sub { font-size:10px;color:rgba(255,255,255,0.45);letter-spacing:3px;text-transform:uppercase;margin-top:2px; }
.hero-links { display:flex;gap:24px; }
.hero-links a { color:rgba(255,255,255,0.55);font-size:13px;text-decoration:none;transition:color .2s; }
.hero-links a:hover { color:var(--verde-light); }
.hero-body { display:flex;align-items:center;padding:0 60px;position:relative;z-index:2; }
.hero-text { max-width:620px; }
.hero-eyebrow {
  display:inline-flex;align-items:center;gap:10px;color:var(--verde-light);
  font-size:11px;letter-spacing:4px;text-transform:uppercase;margin-bottom:28px;
}
.hero-eyebrow::before { content:'';display:block;width:32px;height:1px;background:var(--verde-light); }
.hero-title {
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(52px,7vw,96px);font-weight:300;color:white;
  line-height:1.0;letter-spacing:-2px;margin-bottom:28px;
}
.hero-title strong { font-weight:700;color:var(--verde-light);font-style:italic;display:block; }
.hero-desc { font-size:16px;color:rgba(255,255,255,0.5);line-height:1.7;max-width:420px;margin-bottom:44px; }
.hero-cta {
  display:inline-flex;align-items:center;gap:10px;background:var(--verde-light);
  color:var(--verde);font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
  padding:16px 32px;border-radius:100px;text-decoration:none;transition:all .25s;
}
.hero-cta:hover { background:white;transform:translateY(-2px);box-shadow:0 12px 40px rgba(0,0,0,.2); }
.hero-bottom {
  padding:32px 60px;position:relative;z-index:2;
  display:flex;justify-content:space-between;align-items:flex-end;
  border-top:1px solid rgba(255,255,255,.08);
}
.hero-stat { text-align:center; }
.hero-stat-num { font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:700;color:white; }
.hero-stat-label { font-size:11px;color:rgba(255,255,255,.4);letter-spacing:2px;text-transform:uppercase;margin-top:2px; }
.hero-advisor { text-align:right;color:rgba(255,255,255,.45);font-size:13px;line-height:1.7; }
.hero-advisor strong { color:white;display:block;font-size:15px;margin-bottom:2px; }

/* ─── NAV ─── */
.sticky-nav {
  position:sticky;top:0;z-index:100;
  background:rgba(27,67,50,.97);backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(255,255,255,.08);
}
.nav-inner {
  max-width:1200px;margin:0 auto;padding:0 40px;
  display:flex;gap:2px;overflow-x:auto;
}
.nav-inner::-webkit-scrollbar { height:0; }
.nav-btn {
  background:none;border:none;color:rgba(255,255,255,.5);
  font-family:'Inter',sans-serif;font-size:11px;font-weight:500;
  letter-spacing:1.5px;text-transform:uppercase;
  padding:16px 20px;cursor:pointer;white-space:nowrap;
  border-bottom:2px solid transparent;transition:all .2s;
}
.nav-btn:hover,.nav-btn.active { color:var(--verde-light);border-bottom-color:var(--verde-light); }

/* ─── MAIN ─── */
.main { max-width:1200px;margin:0 auto;padding:80px 40px; }
.section { margin-bottom:100px; }
.full-divider {
  height:1px;
  background:linear-gradient(to right,transparent,var(--gris-300),transparent);
  margin:80px 0;
}

/* ─── SECTION HEADER ─── */
.sec-head { margin-bottom:52px; }
.sec-tag {
  display:inline-flex;align-items:center;gap:8px;color:var(--verde-med);
  font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;
}
.sec-tag::before { content:'';display:block;width:24px;height:2px;background:var(--verde-light); }
.sec-title {
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(34px,5vw,56px);font-weight:300;color:var(--verde);
  line-height:1.05;letter-spacing:-1px;
}
.sec-title em { font-style:italic;font-weight:700;color:var(--verde-light); }
.sec-divider { width:60px;height:2px;background:var(--verde-pale);margin-top:18px; }

/* ─── GRID ─── */
.grid-3 { display:grid;grid-template-columns:repeat(3,1fr);gap:20px; }
.grid-2 { display:grid;grid-template-columns:repeat(2,1fr);gap:20px; }
.grid-4 { display:grid;grid-template-columns:repeat(4,1fr);gap:20px; }
.mt { margin-top:20px; }

/* ─── CARD ─── */
.card {
  background:white;border-radius:16px;overflow:hidden;
  box-shadow:0 2px 16px rgba(0,0,0,.06);
  transition:transform .3s ease, box-shadow .3s ease;
}
.card:hover { transform:translateY(-5px);box-shadow:0 16px 48px rgba(27,67,50,.12); }

/* KEY CHANGE: object-fit:contain + neutral bg — no stretching */
.card-img {
  background: radial-gradient(ellipse at center, #edeae3 0%, #e0dcd3 100%);
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;position:relative;
  padding: 20px;
}
.card-img img {
  max-width:100%;max-height:100%;
  width:auto;height:auto;
  object-fit:contain;
  display:block;
  transition:transform .4s cubic-bezier(.25,.46,.45,.94);
  filter: drop-shadow(0 8px 24px rgba(0,0,0,.18));
}
.card:hover .card-img img { transform:scale(1.04) translateY(-4px); }

.card-body { padding:22px 24px 26px; }
.card-cat {
  font-size:10px;font-weight:600;letter-spacing:3px;
  text-transform:uppercase;color:var(--verde-light);margin-bottom:6px;
}
.card-name {
  font-family:'Cormorant Garamond',serif;
  font-size:24px;font-weight:700;color:var(--verde);
  line-height:1.1;margin-bottom:10px;
}
.card-desc { font-size:13px;color:var(--gris-500);line-height:1.65;margin-bottom:14px; }
.card-features { display:flex;flex-wrap:wrap;gap:6px; }
.feat-pill {
  background:var(--gris-100);color:var(--gris-700);
  font-size:11px;padding:4px 10px;border-radius:100px;
  border:1px solid var(--gris-200);
}

/* CARD HORIZONTAL */
.card-h { display:grid;grid-template-columns:300px 1fr; }
.card-h .card-img { height:auto;min-height:260px; }
.card-h .card-name { font-size:30px; }

/* CARD FEATURED (2 cols) */
.card-feat { grid-column:span 2; }
.card-feat .card-img { height:340px; }
.card-feat .card-name { font-size:32px; }

/* ─── FOOTER ─── */
footer {
  background:var(--verde);color:white;
  padding:80px 60px 60px;
  display:grid;grid-template-columns:1fr 1fr 1fr;gap:60px;
  position:relative;overflow:hidden;
}
footer::before {
  content:'';position:absolute;top:-100px;right:-100px;
  width:500px;height:500px;border-radius:50%;
  background:rgba(82,183,136,.07);pointer-events:none;
}
footer h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:32px;font-weight:300;margin-bottom:16px;
}
footer p { font-size:14px;color:rgba(255,255,255,.5);line-height:1.7;max-width:280px; }
.ft-h { font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--verde-light);margin-bottom:20px; }
.ft-item { margin-bottom:14px; }
.ft-item span { display:block;font-size:11px;color:rgba(255,255,255,.35);letter-spacing:1px;text-transform:uppercase;margin-bottom:3px; }
.ft-item strong { font-size:15px;color:white;font-weight:400; }
.ft-copy {
  grid-column:1/-1;padding-top:40px;
  border-top:1px solid rgba(255,255,255,.1);
  font-size:12px;color:rgba(255,255,255,.3);
  display:flex;justify-content:space-between;
}

@media(max-width:960px) {
  .hero-top,.hero-body,.hero-bottom { padding:28px 24px; }
  .hero-links { display:none; }
  .main { padding:60px 20px; }
  .grid-3,.grid-4 { grid-template-columns:repeat(2,1fr); }
  .grid-2 { grid-template-columns:1fr; }
  .card-feat { grid-column:span 1; }
  .card-feat .card-img { height:260px; }
  .card-h { grid-template-columns:1fr; }
  .card-h .card-img { min-height:240px; }
  footer { grid-template-columns:1fr;padding:48px 24px 40px;gap:40px; }
  .ft-copy { flex-direction:column;gap:8px; }
  .nav-inner { padding:0 20px; }
}
@media(max-width:580px) {
  .grid-3,.grid-4 { grid-template-columns:1fr; }
}
</style>
</head>
